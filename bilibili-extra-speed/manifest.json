{
  "manifest_version": 3,
  "name": "B站倍速增强",
  "version": "1.0.0",
  "description": "在哔哩哔哩播放器的倍速菜单中增加 2.5x、3x、4x、4.5x、5x 档位。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
